{
  "name": "senado-br-mcp",
  "version": "3.7.0",
  "description": "MCP server for Brazilian Senate open data — runs hosted on Cloudflare Workers or locally via npx (stdio)",
  "license": "MIT",
  "type": "module",
  "mcpName": "io.github.SidneyBissoli/senado-br-mcp-cloudflare",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SidneyBissoli/senado-br-mcp-cloudflare.git"
  },
  "bin": {
    "senado-br-mcp": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build && npm test",
    "version": "node scripts/sync-version.mjs && git add -u",
    "typecheck": "tsc --noEmit && tsc -p scripts/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:contract": "vitest run -c vitest.contract.config.ts",
    "contract:refresh": "tsx scripts/contract/refresh-fixtures.ts",
    "eval:questions": "tsx scripts/eval/generate-perguntas.ts",
    "eval:dry": "tsx scripts/eval/run.ts --dry",
    "eval": "tsx scripts/eval/run.ts",
    "eval:judge": "tsx scripts/eval/judge.ts",
    "eval:report": "tsx scripts/eval/report.ts",
    "smoke:openai-app": "node scripts/smoke-openai-app.mjs",
    "smoke:stdio": "node scripts/smoke-stdio.mjs",
    "ingest:ecidadania": "tsx scripts/ingest-ecidadania/index.ts",
    "ingest:ecidadania:eventos": "tsx scripts/ingest-ecidadania/index-eventos.ts",
    "ingest:ecidadania:ideias": "tsx scripts/ingest-ecidadania/index-ideias.ts",
    "ingest:ecidadania:ideias-detalhe": "tsx scripts/ingest-ecidadania/index-ideias-detalhe.ts",
    "ingest:ecidadania:consultas-votos": "tsx scripts/ingest-ecidadania/index-consultas-votos.ts",
    "ingest:estrutura": "tsx scripts/ingest-estrutura/index.ts",
    "build:dataset": "tsx scripts/build-dataset/index.ts",
    "dataset:dictionary": "tsx scripts/build-dataset/index.ts --dictionary-only",
    "release:dataset": "tsx scripts/build-dataset/release.ts",
    "release:zenodo": "tsx scripts/build-dataset/zenodo-publish.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "@sbissoli/mcp-provenance": "^0.1.0",
    "@sbissoli/mcp-search": "^0.3.0",
    "@sbissoli/mcp-stats": "^0.2.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260830.1",
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@sbissoli/mcp-evals": "^0.1.0",
    "@types/node": "^26.4.0",
    "agents": "^0.22.0",
    "exceljs": "^4.4.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.1"
  },
  "overrides": {
    "fast-uri": "^4.0.0",
    "hono": "^4.12.27",
    "@hono/node-server": "^1.19.13",
    "express-rate-limit": "^8.5.2",
    "ip-address": "^10.2.0",
    "qs": "^6.16.0",
    "path-to-regexp": "^8.4.2",
    "lodash": "^4.18.1",
    "js-yaml": "^4.2.0",
    "undici": "^7.28.0",
    "ws": "^8.21.0",
    "picomatch": "^4.0.4",
    "postcss": "^8.5.10",
    "uuid": "^11.1.1"
  }
}
